# Local Content Agent - Environment Variables
# Copy this file to .env and fill in your keys

# Required: DeepSeek API key (or any OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=sk-your-key-here

# Optional: Custom API endpoint (defaults to api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: Perplexity Pro via Chrome CDP (port 9222)
# Requires: open -a "Google Chrome" --args --remote-debugging-port=9222
# PERPLEXITY_ENABLED=true

# Optional: Output directory (defaults to ./output)
# LCA_OUTPUT_DIR=./output
